generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique @db.VarChar(255)
  name          String          @db.VarChar(255)
  phone         String?         @db.VarChar(32)
  passwordHash  String?         @map("password_hash") @db.VarChar(255)
  role          Role            @default(USER)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs     AuditLog[]      @relation("ActorAuditLogs")
  authProviders AuthProvider[]
  follows       Follow[]
  holds         InventoryHold[]
  orders        Order[]
  organiser     Organiser?
  resets        PasswordReset[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model AuthProvider {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(32)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_providers")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Organiser {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @unique @map("user_id") @db.Uuid
  businessName  String          @map("business_name") @db.VarChar(255)
  abn           String?         @db.VarChar(32)
  contactEmail  String          @map("contact_email") @db.VarChar(255)
  contactPhone  String?         @map("contact_phone") @db.VarChar(32)
  payoutDetails Json?           @map("payout_details")
  status        OrganiserStatus @default(PENDING)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  events        Event[]
  ledgerEntries LedgerEntry[]
  user          User            @relation(fields: [userId], references: [id])
  payouts       Payout[]

  @@map("organisers")
}

model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  address   String
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(50)
  capacity  Int      @default(0)
  timezone  String   @default("Australia/Sydney") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events    Event[]

  @@index([city, state])
  @@map("venues")
}

model Artist {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(255)
  slug      String        @unique @db.VarChar(255)
  bio       String?
  imagePath String?       @map("image_path") @db.VarChar(512)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  events    EventArtist[]
  follows   Follow[]

  @@map("artists")
}

model Event {
  id            String        @id @default(uuid()) @db.Uuid
  organiserId   String        @map("organiser_id") @db.Uuid
  venueId       String        @map("venue_id") @db.Uuid
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  description   String
  posterPath    String?       @map("poster_path") @db.VarChar(512)
  startsAt      DateTime      @map("starts_at") @db.Timestamptz(6)
  doorsOpenAt   DateTime?     @map("doors_open_at") @db.Timestamptz(6)
  status        EventStatus   @default(DRAFT)
  category      String        @default("Concert") @db.VarChar(64)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  banners       Banner[]
  artists       EventArtist[]
  organiser     Organiser     @relation(fields: [organiserId], references: [id])
  venue         Venue         @relation(fields: [venueId], references: [id])
  ledgerEntries LedgerEntry[]
  orders        Order[]
  payouts       Payout[]
  ticketTypes   TicketType[]

  @@index([status, startsAt])
  @@index([organiserId])
  @@index([venueId])
  @@map("events")
}

model EventArtist {
  eventId    String  @map("event_id") @db.Uuid
  artistId   String  @map("artist_id") @db.Uuid
  isHeadline Boolean @default(true) @map("is_headline")
  artist     Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@map("event_artists")
}

model Follow {
  userId    String   @map("user_id") @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("follows")
}

model TicketType {
  id           String          @id @default(uuid()) @db.Uuid
  eventId      String          @map("event_id") @db.Uuid
  name         String          @db.VarChar(128)
  priceCents   Int             @map("price_cents")
  quantity     Int
  available    Int
  sold         Int             @default(0)
  saleStartsAt DateTime        @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt   DateTime        @map("sale_ends_at") @db.Timestamptz(6)
  minPerOrder  Int             @default(1) @map("min_per_order")
  maxPerOrder  Int             @default(10) @map("max_per_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  holds        InventoryHold[]
  orderItems   OrderItem[]
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, saleStartsAt, saleEndsAt])
  @@map("ticket_types")
}

model InventoryHold {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  quantity     Int
  status       HoldStatus @default(ACTIVE)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([ticketTypeId, status, expiresAt])
  @@index([userId, status])
  @@map("inventory_holds")
}

model Order {
  id               String         @id @default(uuid()) @db.Uuid
  orderNumber      String         @unique @map("order_number") @db.VarChar(32)
  userId           String         @map("user_id") @db.Uuid
  eventId          String         @map("event_id") @db.Uuid
  holdId           String?        @map("hold_id") @db.Uuid
  status           OrderStatus    @default(PENDING)
  ticketTotalCents Int            @map("ticket_total_cents")
  buyerFeeCents    Int            @default(0) @map("buyer_fee_cents")
  totalCents       Int            @map("total_cents")
  currency         String         @default("AUD") @db.VarChar(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  ledgerEntries    LedgerEntry[]
  items            OrderItem[]
  event            Event          @relation(fields: [eventId], references: [id])
  hold             InventoryHold? @relation(fields: [holdId], references: [id])
  user             User           @relation(fields: [userId], references: [id])
  payment          Payment?
  refund           Refund?
  tickets          Ticket[]

  @@index([userId, status])
  @@index([eventId, status])
  @@map("orders")
}

model OrderItem {
  id             String     @id @default(uuid()) @db.Uuid
  orderId        String     @map("order_id") @db.Uuid
  ticketTypeId   String     @map("ticket_type_id") @db.Uuid
  quantity       Int
  unitPriceCents Int        @map("unit_price_cents")
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  attendeeName  String       @map("attendee_name") @db.VarChar(255)
  attendeeEmail String       @map("attendee_email") @db.VarChar(255)
  qrTokenHash   String       @unique @map("qr_token_hash") @db.VarChar(255)
  status        TicketStatus @default(VALID)
  usedAt        DateTime?    @map("used_at") @db.Timestamptz(6)
  usedGate      String?      @map("used_gate") @db.VarChar(64)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  scanLogs      ScanLog[]
  order         Order        @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("tickets")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @unique @map("order_id") @db.Uuid
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  amountCents           Int           @map("amount_cents")
  stripeFeeCents        Int           @default(0) @map("stripe_fee_cents")
  netCents              Int           @default(0) @map("net_cents")
  cardCountry           String?       @map("card_country") @db.VarChar(2)
  cardBrand             String?       @map("card_brand") @db.VarChar(32)
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds               Refund[]

  @@map("payments")
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @unique @map("order_id") @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  stripeRefundId String?      @unique @map("stripe_refund_id") @db.VarChar(255)
  amountCents    Int          @map("amount_cents")
  status         RefundStatus @default(PENDING)
  reason         String?      @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  order          Order        @relation(fields: [orderId], references: [id])
  payment        Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  organiserId String          @map("organiser_id") @db.Uuid
  eventId     String          @map("event_id") @db.Uuid
  orderId     String?         @map("order_id") @db.Uuid
  type        LedgerEntryType
  amountCents Int             @map("amount_cents")
  description String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  event       Event           @relation(fields: [eventId], references: [id])
  order       Order?          @relation(fields: [orderId], references: [id])
  organiser   Organiser       @relation(fields: [organiserId], references: [id])

  @@index([organiserId, eventId])
  @@index([orderId])
  @@map("ledger_entries")
}

model Payout {
  id          String       @id @default(uuid()) @db.Uuid
  organiserId String       @map("organiser_id") @db.Uuid
  eventId     String       @map("event_id") @db.Uuid
  amountCents Int          @map("amount_cents")
  status      PayoutStatus @default(PENDING)
  reference   String?      @db.VarChar(128)
  paidAt      DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  event       Event        @relation(fields: [eventId], references: [id])
  organiser   Organiser    @relation(fields: [organiserId], references: [id])

  @@index([organiserId, status])
  @@map("payouts")
}

model ScanLog {
  id        String     @id @default(uuid()) @db.Uuid
  ticketId  String     @map("ticket_id") @db.Uuid
  gate      String     @db.VarChar(64)
  deviceId  String     @map("device_id") @db.VarChar(128)
  result    ScanResult
  scannedAt DateTime   @default(now()) @map("scanned_at") @db.Timestamptz(6)
  ticket    Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, scannedAt])
  @@map("scan_logs")
}

model WebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id") @db.VarChar(255)
  eventType     String   @map("event_type") @db.VarChar(128)
  payload       Json
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("webhook_events")
}

model SavedRequest {
  key         String   @id @db.VarChar(255)
  requestHash String   @map("request_hash") @db.VarChar(255)
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("saved_requests")
}

model EmailBlocklist {
  email     String   @id @db.VarChar(255)
  reason    String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_blocklist")
}

model PlatformSettings {
  key       String   @id @db.VarChar(128)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(128)
  entity    String   @db.VarChar(64)
  entityId  String   @map("entity_id") @db.Uuid
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Banner {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(255)
  imageUrl     String   @map("image_url") @db.VarChar(512)
  targetUrl    String?  @map("target_url") @db.VarChar(512)
  eventId      String?  @map("event_id") @db.Uuid
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  event        Event?   @relation(fields: [eventId], references: [id])

  @@index([isActive, displayOrder])
  @@map("banners")
}

enum Role {
  USER
  ORGANISER
  ADMIN
}

enum OrganiserStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  POSTPONED
  CANCELLED
  COMPLETED
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LedgerEntryType {
  SALE
  BUYER_FEE
  STRIPE_FEE
  REFUND
  PAYOUT
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  BLOCKED
}

enum ScanResult {
  VALID
  ALREADY_USED
  INVALID
  WRONG_EVENT
  CANCELLED
}

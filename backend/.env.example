# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Resend Email Configuration
RESEND_API_KEY=re_test_placeholder
EMAIL_FROM=tickets@mytix.example.com

# Supabase Storage (Sydney Region)
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# Ticket Security (Ed25519)
TICKET_ED25519_PRIVATE_KEY=placeholder_base64_ed25519_private_key
TICKET_ED25519_PUBLIC_KEY=placeholder_base64_ed25519_public_key

# Logging
LOG_LEVEL=debug

# Order & Hold Rules
ORDER_MIN_TICKETS=1
ORDER_MAX_TICKETS=10
HOLD_DURATION_MINUTES=10
PASSWORD_RESET_EXPIRATION_MINUTES=30

# In-Memory Cache TTL (Seconds)
CACHE_AVAILABILITY_SECONDS=5
CACHE_CATALOG_SECONDS=15
CACHE_STATIC_PAGES_SECONDS=30

# File Upload Limits
MAX_FILE_SIZE_MB=5

# Server Configuration
NODE_ENV=
PORT=
FRONTEND_URL=
ADMIN_URL=
ALLOWED_ORIGINS=
# COOKIE_DOMAIN=.mytix.com (optional for sharing auth cookies across subdomains in production)


# Database Connection (PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION_DAYS=

# Google OAuth
GOOGLE_CLIENT_ID=

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend Email Configuration
RESEND_API_KEY=
EMAIL_FROM=

# Supabase Storage (Sydney Region)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ticket Security (Ed25519)
TICKET_ED25519_PRIVATE_KEY=
TICKET_ED25519_PUBLIC_KEY=

# Logging
LOG_LEVEL=
# Order & Hold Rules
ORDER_MIN_TICKETS=
ORDER_MAX_TICKETS=
HOLD_DURATION_MINUTES=
PASSWORD_RESET_EXPIRATION_MINUTES=

# In-Memory Cache TTL (Seconds)
CACHE_AVAILABILITY_SECONDS=
CACHE_CATALOG_SECONDS=
CACHE_STATIC_PAGES_SECONDS=

# File Upload Limits
MAX_FILE_SIZE_MB=
